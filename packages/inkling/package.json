{
  "name": "@jatin_ux/inkling",
  "version": "0.1.1",
  "description": "Turn hand-drawn strokes into installable OTF and WOFF fonts, in the browser or Node. Regular and Bold weights, automatic accents, zero dependencies.",
  "license": "MIT",
  "author": "Jatin Bansal",
  "homepage": "https://jatinbansal.vercel.app/inkling",
  "bugs": {
    "url": "https://github.com/jatinbansalwork-commits/Inkling/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinbansalwork-commits/Inkling.git",
    "directory": "packages/inkling"
  },
  "keywords": ["font", "handwriting", "opentype", "otf", "woff", "font-maker", "font-generator", "typography", "browser", "signature"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
