{
  "name": "@jatin_ux/inkling",
  "version": "0.1.0",
  "description": "Turn hand-drawn strokes into installable OTF and WOFF fonts, in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinbansalwork-commits/Inkling.git",
    "directory": "packages/inkling"
  },
  "keywords": ["font", "handwriting", "opentype", "otf", "woff", "font-maker"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
